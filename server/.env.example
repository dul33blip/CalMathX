API_PORT=5000
# Local MongoDB or an Atlas connection string. If unreachable, solving still works (no history).
MONGO_URI=mongodb://127.0.0.1:27017/calmathx
# Python executable that has SymPy installed (python on Windows, python3 on macOS/Linux)
PYTHON=python
# Give up on a single problem after this long
SOLVE_TIMEOUT_MS=30000
